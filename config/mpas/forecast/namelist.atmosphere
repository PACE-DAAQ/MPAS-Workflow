&nhyd_model
    config_time_integration_order = 2
    config_dt = modelDT
    config_start_time = 'startTime'
    config_run_duration = 'fcLength'
    config_split_dynamics_transport = true
    config_number_of_sub_steps = 4
    config_dynamics_split_steps = 3
    config_horiz_mixing = '2d_smagorinsky'
    config_len_disp = diffusionLengthScale
    config_visc4_2dsmag = 0.05
    config_scalar_advection = true
    config_monotonic = true
    config_coef_3rd_order = 0.25
    config_epssm = 0.1
    config_smdiv = 0.1
    config_positive_definite = false
/
    config_h_mom_eddy_visc2 = 0.0
    config_h_mom_eddy_visc4 = 0.0
    config_v_mom_eddy_visc2 = 0.0
    config_h_theta_eddy_visc2 = 0.0
    config_h_theta_eddy_visc4 = 0.0
    config_v_theta_eddy_visc2 = 0.0
    config_w_adv_order = 3
    config_theta_adv_order = 3
    config_scalar_adv_order = 3
    config_u_vadv_order = 3
    config_w_vadv_order = 3
    config_theta_vadv_order = 3
    config_scalar_vadv_order = 3

&damping
    config_zd = 22000.0
    config_xnutr = 0.2
/
&limited_area
    config_apply_lbcs = false
/
&io
    config_pio_num_iotasks = 0
    config_pio_stride = 32
/
&decomposition
    config_block_decomp_file_prefix = 'x{{meshRatio}}.nCells.graph.info.part.'
/
&restart
    config_do_restart = false
    config_do_DAcycling = configDODACycling
/
&printout
    config_print_global_minmax_vel = true
    config_print_detailed_minmax_vel = true
/
&IAU
    config_IAU_option = '{{IAU}}'
    config_IAU_window_length_s = 21600.
/
&assimilation
    config_jedi_da = true
/
&physics
    config_sst_update          = false
    config_sstdiurn_update     = false
    config_deepsoiltemp_update = false
    config_radtlw_interval     = 'radtlwInterval'
    config_radtsw_interval     = 'radtswInterval'
    config_o3climatology       = true
    config_bucket_update       = 'none'
    config_physics_suite       = 'physicsSuite'
    config_microp_scheme       = 'micropScheme'
    config_convection_scheme   = 'convectionScheme'
    config_pbl_scheme          = 'pblScheme'
    config_gwdo_scheme         = 'gwdoScheme'
    config_radt_cld_scheme     = 'radtCldScheme'
    config_radt_lw_scheme      = 'radtLWScheme'
    config_radt_sw_scheme      = 'radtSWScheme'
    config_sfclayer_scheme     = 'sfcLayerScheme'
    config_lsm_scheme          = 'lsmScheme'
    config_mynn_mixchems = true
    config_ntiedtke_ctrchems = true
    config_ntiedtke_scavchems = true
/
    config_microp_re           = true

&soundings
    config_sounding_interval = 'none'
/
&physics_lsm_noahmp
    config_noahmp_iopt_dveg = 4
    config_noahmp_iopt_crs = 1
    config_noahmp_iopt_btr = 1
    config_noahmp_iopt_runsrf = 3
    config_noahmp_iopt_runsub = 3
    config_noahmp_iopt_sfc = 1
    config_noahmp_iopt_frz = 1
    config_noahmp_iopt_inf = 1
    config_noahmp_iopt_rad = 3
    config_noahmp_iopt_alb = 1
    config_noahmp_iopt_snf = 1
    config_noahmp_iopt_tksno = 1
    config_noahmp_iopt_tbot = 2
    config_noahmp_iopt_stc = 1
    config_noahmp_iopt_gla = 1
    config_noahmp_iopt_rsf = 4
    config_noahmp_iopt_soil = 1
    config_noahmp_iopt_pedo = 1
    config_noahmp_iopt_crop = 0
    config_noahmp_iopt_irr = 0
    config_noahmp_iopt_irrm = 0
    config_noahmp_iopt_infdv = 1
    config_noahmp_iopt_tdrn = 0
/

&chemistry
    config_gocart2G_do_CA2Gbc       = true
    config_gocart2G_do_CA2Gbr       = true
    config_gocart2G_do_CA2Goc       = true
    config_gocart2G_do_SOA2G        = true
    config_gocart2G_do_DU2G         = true
    config_gocart2G_do_NI2G         = true
    config_gocart2G_do_SS2G         = true
    config_gocart2G_do_SU2G         = true
    config_gocart2G_toRRTMG = true
    config_gocart2G_toMYNN  = true
    config_gocart2G_toTHOM = true
    config_gocart2G_toNTIEDTKE = true
    config_gocart2G_biobemis_interval = '00_01:00:00'
    config_gocart2G_hno3_tau = 86400.0
    config_gocart2G_opticsBC = 'optics_BC.v1_5.nc'
    config_gocart2G_opticsBC_RRTMG = 'opticsBands_BC.v1_5.RRTMG.nc'
    config_gocart2G_opticsOC = 'optics_OC.v1_5.nc'
    config_gocart2G_opticsOC_RRTMG = 'opticsBands_OC.v1_5.RRTMG.nc'
    config_gocart2G_opticsBR = 'optics_BRC.v2_5.nc'
    config_gocart2G_opticsBR_RRTMG = 'opticsBands_BRC.v2_5.RRTMG.nc'
    config_gocart2G_opticsDU = 'optics_DU.v15_5.nc'
    config_gocart2G_opticsDU_RRTMG = 'opticsBands_DU.v15_5.RRTMG.nc'
    config_gocart2G_opticsSS = 'optics_SS.v3_5.nc'
    config_gocart2G_opticsSS_RRTMG = 'opticsBands_SS.v3_5.RRTMG.nc'
    config_gocart2G_opticsSU = 'optics_SU.v2_5.nc'
    config_gocart2G_opticsSU_RRTMG = 'opticsBands_SU.v2_5.RRTMG.nc'
    config_gocart2G_opticsNI = 'optics_NI.v2_5.nc'
    config_gocart2G_opticsNI_RRTMG = 'opticsBands_NI.v2_5.RRTMG.nc'
/
