<streams>
<immutable_stream name="invariant"
                  type="input"
                  precision="{{PRECISION}}"
                  filename_template="{{InvariantFieldsPrefix}}.{{nCells}}.nc"
                  io_type="pnetcdf,cdf5"
                  input_interval="initial_only" />

<immutable_stream name="input"
                  type="input"
                  precision="{{PRECISION}}"
                  filename_template="{{ICFilePrefix}}.$Y-$M-$D_$h.$m.$s.nc"
                  io_type="pnetcdf,cdf5"
                  input_interval="initial_only" />

<immutable_stream name="iau"
                  type="input"
                  precision="{{PRECISION}}"
                  filename_template="AmB.$Y-$M-$D_$h.$m.$s.nc"
                  filename_interval="none"
                  packages="iau"
                  io_type="pnetcdf,cdf5"
                  input_interval="initial_only" />

<stream name="dastate"
        type="output"
        precision="{{PRECISION}}"
        clobber_mode="truncate"
        filename_template="{{FCFilePrefix}}.$Y-$M-$D_$h.$m.$s.nc"
        io_type="pnetcdf,cdf5"
        clobber_mode="overwrite"
        io_type="pnetcdf,cdf5"
        output_interval="{{outputInterval}}" >
        <file name="stream_list.atmosphere.dastate"/>
</stream>

<stream name="output"
        type="none"
        filename_template="history.$Y-$M-$D_$h.$m.$s.nc"
        output_interval="none" >
</stream>

<stream name="diagnostics"
        type="output"
        precision="{{PRECISION}}"
        clobber_mode="truncate"
        filename_template="diag.$Y-$M-$D_$h.$m.$s.nc"
        io_type="pnetcdf,cdf5"
        clobber_mode="overwrite"
        output_interval="{{outputInterval}}" >
        <file name="stream_list.atmosphere.diagnostics"/>
</stream>

<stream name="surface"
        type="input"
        precision="{{surfacePrecision}}"
        filename_template="{{surfaceUpdateFile}}"
        filename_interval="none"
        input_interval="{{surfaceInputInterval}}" >
	<file name="stream_list.atmosphere.surface"/>
</stream>

<stream name="anth_bc_emissions"
        type="input"
        filename_template="{{anthBC}}"
        input_interval="none">
        immutable="false"

        <var name="bc_anth_res"/>
        <var name="bc_anth_sum"/>
</stream>

<stream name="anth_oc_emissions"
        type="input"
        filename_template="{{anthOC}}"
        input_interval="none">
        immutable="false"

        <var name="oc_anth_res"/>
        <var name="oc_anth_sum"/>
</stream>

<stream name="anth_nh3_emissions"
        type="input"
        filename_template="x1.163842-2024-anth_ammonia.MPAS.nc"
        input_interval="none">
        immutable="false"

        <var name="nh3_anth_agl"/>
        <var name="nh3_anth_ags"/>
        <var name="nh3_anth_awb"/>
        <var name="nh3_anth_ene"/>
        <var name="nh3_anth_fef"/>
        <var name="nh3_anth_ind"/>
        <var name="nh3_anth_res"/>
        <var name="nh3_anth_shp"/>
        <var name="nh3_anth_slv"/>
        <var name="nh3_anth_sum"/>
        <var name="nh3_anth_swd"/>
        <var name="nh3_anth_tnr"/>
        <var name="nh3_anth_tro"/>
</stream>

<stream name="anth_so2_emissions"
        type="input"
        filename_template="{{anthSO2}}"
        input_interval="none">
        immutable="false"

        <var name="so2_anth_sum"/>
</stream>

<stream name="anth_iso_emissions"
        type="input"
        filename_template="x1.163842-2024-anth_isoprene.MPAS.nc"
        input_interval="none">
        immutable="false"

        <var name="iso_anth_sum"/>
</stream>

<stream name="anth_mnt_emissions"
        type="input"
        filename_template="x1.163842-2024-anth_monoterpenes.MPAS.nc"
        input_interval="none">
        immutable="false"

        <var name="mnt_anth_sum"/>
</stream>

<stream name="anth_co_emissions"
        type="input"
        filename_template="{{anthCO}}"
        input_interval="none">
        immutable="false"

        <var name="co_anth_sum"/>
</stream>

<stream name="biob_bc_emissions"
        type="input"
        filename_template="{{biobBC}}"
        input_interval="none">
        immutable="false"

        <var name="bc_biob_modis"/>
</stream>

<stream name="biob_oc_emissions"
        type="input"
        filename_template="{{biobOC}}"
        input_interval="none">
        immutable="false"

        <var name="oc_biob_modis"/>
</stream>

<stream name="biob_ni_emissions"
        type="input"
        filename_template="{{biobNH3}}"
        input_interval="none">
        immutable="false"

        <var name="nh3_biob_modis"/>
</stream>

<stream name="biob_su_emissions"
        type="input"
        filename_template="{{biobSO2}}"
        input_interval="none">
        immutable="false"

        <var name="so2_biob_modis"/>
</stream>

<stream name="biob_co_emissions"
        type="input"
        filename_template="{{biobCO}}"
        input_interval="none">
        immutable="false"

        <var name="co_biob_modis"/>
</stream>
<stream name="biob_iso_emissions"
        type="input"
        filename_template="{{biobISO}}"
        input_interval="none">
        immutable="false"

        <var name="iso_biob_modis"/>
</stream>

<stream name="biob_mnt_emissions"
        type="input"
        filename_template="{{biobMNT}}"
        input_interval="none">
        immutable="false"

        <var name="mnt_biob_modis"/>
</stream>

<stream name="biog_co_emissions"
        type="input"
        filename_template="{{biogCO}}"
        input_interval="none">
        immutable="false"

        <var name="co_biog_megan"/>
</stream>

<stream name="biog_iso_emissions"
        type="input"
        filename_template="{{biogISO}}"
        input_interval="none">
        immutable="false"

        <var name="iso_biog_megan"/>
</stream>

<stream name="biog_mnt_emissions"
        type="input"
        filename_template="{{biogMNT}}"
        input_interval="none">
        immutable="false"

        <var name="mnt_biog_megan"/>
</stream>

<stream name="biog_apinene_emissions"
        type="input"
        filename_template="{{biogAPIN}}"
        input_interval="none">
        immutable="false"

        <var name="mnta_biog_megan"/>
</stream>

<stream name="biog_bpinene_emissions"
        type="input"
        filename_template="{{biogBPIN}}"
        input_interval="none">
        immutable="false"

        <var name="mntb_biog_megan"/>
</stream>

<stream name="prm_lbc_area_avg"
        type="input"
        filename_template="{{prmArea}}"
        input_interval="none">
        immutable="false"
        
        <var name="area_biob_modis"/>
</stream>

</streams>
